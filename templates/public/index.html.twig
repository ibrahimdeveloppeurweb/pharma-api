    <script>
        // ─── INDEX MEDICAMENTS LOGIC ────────────────────────────────────────
        let indexMedicaments = [];

        function addIndexMedicament(nameToAdd = null) {
            const input = document.getElementById('indexMedicamentInput');
            const val = nameToAdd !== null ? nameToAdd.trim() : input.value.trim();
            if (val && !indexMedicaments.includes(val)) {
                indexMedicaments.push(val);
                if (nameToAdd === null) input.value = '';
                renderIndexList();
            }
        }

        async function handleOrdonnanceUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            // Show loading state
            const uploadBtn = event.target.previousElementSibling;
            const originalHtml = uploadBtn.innerHTML;
            uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-2xl"></i><span>Analyse en cours...</span><span class="text-xs font-normal text-gray-500">Cela peut prendre quelques secondes</span>';
            uploadBtn.disabled = true;
            uploadBtn.classList.add('opacity-70', 'cursor-not-allowed');

            const formData = new FormData();
            formData.append('image', file);

            try {
                const response = await fetch('/api/v1/public/prescription/extract?mode=exact', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    let totalAdded = 0;
                    if (result.found && result.found.length > 0) {
                        result.found.forEach(med => {
                            addIndexMedicament(med.libelle);
                            totalAdded++;
                        });
                    }
                    if (result.not_found && result.not_found.length > 0) {
                        result.not_found.forEach(medName => {
                            addIndexMedicament(medName);
                            totalAdded++;
                        });
                    }

                    if (totalAdded > 0) {
                        alert(`${totalAdded} médicament(s) extrait(s) de l'ordonnance avec succès !`);
                    } else {
                        alert("L'ordonnance a été analysée, mais aucun médicament n'a pu être extrait de l'image.");
                    }
                } else {
                    alert('Erreur lors de l\'analyse: ' + (result.error || 'Erreur inconnue'));
                }
            } catch (error) {
                console.error(error);
                alert('Une erreur est survenue lors de l\'envoi de l\'image.');
            } finally {
                // Restore button
                uploadBtn.innerHTML = originalHtml;
                uploadBtn.disabled = false;
                uploadBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                event.target.value = ''; // Reset input
            }
        }

        function removeIndexMedicament(index) {
            indexMedicaments.splice(index, 1);
            renderIndexList();
        }

        function renderIndexList() {
            const list = document.getElementById('indexMedicamentList');
            list.innerHTML = '';
            indexMedicaments.forEach((med, idx) => {
                const li = document.createElement('li');
                li.className = "bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-full flex items-center shadow-sm";
                li.innerHTML = `
                    <i class="fas fa-pills text-pharma-green mr-2"></i> ${med}
                    <button onclick="removeIndexMedicament(${idx})" class="ml-3 text-gray-400 hover:text-red-500 focus:outline-none transition-colors">
                        <i class="fas fa-times"></i>
                    </button>
                `;
                list.appendChild(li);
            });
        }

        document.getElementById('indexMedicamentInput').addEventListener('keypress', e => {
            if (e.key === 'Enter') addIndexMedicament();
        });

        // ─── AUTOCOMPLETION LOGIC ────────────────────────────────────────
        const indexInputField = document.getElementById('indexMedicamentInput');
        const indexAutocompleteList = document.getElementById('indexAutocompleteList');
        let indexAutocompleteTimeout = null;

        indexInputField.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.length < 2) {
                indexAutocompleteList.innerHTML = '';
                indexAutocompleteList.classList.add('hidden');
                return;
            }

            if (indexAutocompleteTimeout) clearTimeout(indexAutocompleteTimeout);
            
            indexAutocompleteTimeout = setTimeout(async () => {
                if (indexInputField.value.trim() !== val) return;

                try {
                    const res = await fetch(`/api/v1/public/recherche-medicament/autocomplete?q=${encodeURIComponent(val)}`);
                    const data = await res.json();
                    
                    if (indexInputField.value.trim() !== val) return;

                    if (res.ok && data.data && data.data.length > 0) {
                        indexAutocompleteList.innerHTML = '';
                        data.data.forEach(name => {
                            const li = document.createElement('li');
                            li.className = 'px-4 py-3 hover:bg-pharma-greenLight hover:text-pharma-green cursor-pointer text-sm font-medium border-b border-gray-50 last:border-0 flex items-center text-left';
                            li.innerHTML = `<i class="fas fa-pills opacity-50 mr-3 text-pharma-green"></i> ${name}`;
                            li.addEventListener('click', () => {
                                indexInputField.value = name;
                                indexAutocompleteList.innerHTML = '';
                                indexAutocompleteList.classList.add('hidden');
                                indexInputField.focus();
                                addIndexMedicament(); // Auto-ajouter après le clic (optionnel mais pratique)
                            });
                            indexAutocompleteList.appendChild(li);
                        });
                        indexAutocompleteList.classList.remove('hidden');
                    } else {
                        indexAutocompleteList.innerHTML = '';
                        indexAutocompleteList.classList.add('hidden');
                    }
                } catch (e) {
                    console.error('Erreur autocompletion:', e);
                }
            }, 50); 
        });

        // ─── LOCALISATION (AUTOCOMPLETE) ─────────────────────────────────
        const indexLocInput = document.getElementById('indexLocationInput');
        const indexLocLat = document.getElementById('indexLocLat');
        const indexLocLon = document.getElementById('indexLocLon');
        const indexClearLocBtn = document.getElementById('indexClearLocBtn');
        const indexLocList = document.getElementById('indexLocationAutocompleteList');
        let indexLocTimeout = null;
        // Résolution (réseau) des coordonnées d'un lieu choisi : « Rechercher » l'attend avant de partir
        let indexLocPending = null;

        indexLocInput.addEventListener('input', function(e) {
            const val = e.target.value.trim();
            indexLocLat.value = '';
            indexLocLon.value = '';
            
            if (val.length === 0) {
                indexClearLocBtn.classList.add('hidden');
                indexLocList.classList.add('hidden');
                return;
            }

            indexClearLocBtn.classList.remove('hidden');

            if (indexLocTimeout) clearTimeout(indexLocTimeout);
            indexLocTimeout = setTimeout(async () => {
                if (indexLocInput.value.trim() !== val) return;
                try {
                    const res = await fetch(`/api/v1/public/places/autocomplete?q=${encodeURIComponent(val)}`);
                    const data = await res.json();
                    
                    if (indexLocInput.value.trim() !== val) return;

                    if (data && data.length > 0) {
                        indexLocList.innerHTML = '';
                        data.forEach(place => {
                            const li = document.createElement('li');
                            li.className = 'px-4 py-3 hover:bg-pharma-orange/10 hover:text-pharma-orange cursor-pointer text-sm font-medium border-b border-gray-50 last:border-0 flex items-start text-left';
                            li.innerHTML = `<i class="fas fa-map-marker-alt opacity-50 mr-3 text-pharma-orange mt-1"></i> <span>${place.label}</span>`;
                            li.addEventListener('click', () => {
                                indexLocInput.value = place.label;
                                // Jamais de coordonnées d'un ancien lieu pendant que le nouveau se résout
                                indexLocLat.value = '';
                                indexLocLon.value = '';
                                indexLocList.innerHTML = '';
                                indexLocList.classList.add('hidden');
                                const work = (async () => {
                                    try {
                                        const r = await fetch(`/api/v1/public/places/details?place_id=${encodeURIComponent(place.placeId)}`);
                                        if (r.ok && indexLocPending === work) {
                                            const d = await r.json();
                                            indexLocLat.value = d.lat;
                                            indexLocLon.value = d.lon;
                                        }
                                    } catch (e) { console.error('Erreur details:', e); }
                                })();
                                indexLocPending = work;
                            });
                            indexLocList.appendChild(li);
                        });
                        indexLocList.classList.remove('hidden');
                    } else {
                        indexLocList.classList.add('hidden');
                    }
                } catch (e) {
                    console.error('Erreur loc:', e);
                }
            }, 300);
        });

        function clearIndexLocation() {
            indexLocInput.value = '';
            indexLocLat.value = '';
            indexLocLon.value = '';
            indexClearLocBtn.classList.add('hidden');
            indexLocList.classList.add('hidden');
        }

        document.addEventListener('click', function(e) {
            if (e.target !== indexLocInput && e.target !== indexLocList) {
                indexLocList.classList.add('hidden');
            }
            if (e.target !== indexInputField && e.target !== indexAutocompleteList) {
                indexAutocompleteList.classList.add('hidden');
            }
        });

        // ─── TRANSFERT VERS LA PAGE DE RECHERCHE ─────────────────────────
        async function passerALaRecherche() {
            // S'il y a du texte non validé dans l'input, on l'ajoute d'abord
            const val = document.getElementById('indexMedicamentInput').value.trim();
            if (val) {
                addIndexMedicament();
            }

            // S'il n'y a toujours rien, on ne fait rien ou on affiche une erreur
            if (indexMedicaments.length === 0) {
                alert("Veuillez saisir au moins un médicament.");
                return;
            }

            // Sauvegarder dans localStorage
            localStorage.setItem('pharma_pending_medicaments', JSON.stringify(indexMedicaments));
            localStorage.setItem('pharma_auto_search', 'true'); // Flag to auto-start the search
            
            // Lieu choisi : on attend ses coordonnées si elles arrivent encore (sinon la recherche partirait du GPS)
            if (indexLocPending) { try { await indexLocPending; } catch (e) {} }

            // Position : lieu (nom + coordonnées), ou lieu tapé sans coordonnées (résolu sur la page de recherche),
            // ou rien = GPS du patient
            const locText = indexLocInput.value.trim();
            if (locText) {
                localStorage.setItem('pharma_loc_name', locText);
                if (indexLocLat.value && indexLocLon.value) {
                    localStorage.setItem('pharma_loc_lat', indexLocLat.value);
                    localStorage.setItem('pharma_loc_lon', indexLocLon.value);
                } else {
                    localStorage.removeItem('pharma_loc_lat');
                    localStorage.removeItem('pharma_loc_lon');
                }
            } else {
                localStorage.removeItem('pharma_loc_name');
                localStorage.removeItem('pharma_loc_lat');
                localStorage.removeItem('pharma_loc_lon');
            }

            // Rediriger
            window.location.href = '/recherche-medicaments';
        }

        // ─── COOKIE CONSENT LOGIC ────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            const consentGiven = localStorage.getItem('pharma_cookie_consent');
            const modal = document.getElementById('cookieConsentModal');
            const modalContent = document.getElementById('cookieConsentContent');
            
            if (!consentGiven) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                setTimeout(() => {
                    modal.classList.remove('opacity-0');
                    modalContent.classList.remove('scale-95');
                    modalContent.classList.add('scale-100');
                }, 100);
            }
        });

        function handleCookieConsent(action) {
            if (action === 'details') {
                alert("Redirection vers la page détaillée des paramètres de cookies...");
                return;
            }

            localStorage.setItem('pharma_cookie_consent', action);
            
            const modal = document.getElementById('cookieConsentModal');
            const modalContent = document.getElementById('cookieConsentContent');
            
            modal.classList.add('opacity-0');
            modalContent.classList.remove('scale-100');
            modalContent.classList.add('scale-95');
            
            setTimeout(() => {
                modal.classList.remove('flex');
                modal.classList.add('hidden');
            }, 300);
        }
    </script>
</body>
</html>
