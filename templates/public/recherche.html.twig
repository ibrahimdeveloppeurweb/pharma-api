    <style>
        body { background-color: #fdfbf6; overflow: hidden; }

        /* Custom map markers */
        .custom-marker {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
            border: 3px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.15);
            transition: transform 0.2s;
        }
        .custom-marker.dispo { background-color: #0f5b46; color: white; }
        .custom-marker.limite { background-color: #f26941; color: white; }
        .custom-marker.indispo { background-color: #9ca3af; color: white; }

        .leaflet-marker-icon:hover {
            transform: scale(1.1);
            z-index: 1000 !important;
        }

        /* Pulse animation for user marker */
        .user-marker {
            width: 16px;
            height: 16px;
            background-color: #f26941;
            border-radius: 50%;
            border: 3px solid white;
            box-shadow: 0 0 0 0 rgba(242, 105, 65, 0.7);
            animation: pulse-orange 2s infinite;
        }
        @keyframes pulse-orange {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(242, 105, 65, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 15px rgba(242, 105, 65, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(242, 105, 65, 0); }
        }

