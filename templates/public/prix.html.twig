<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PharmaAlert - Estimation de prix</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,600;1,700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    colors: {
                        pharma: {
                            green: '#0f5b46',
                            greenDark: '#0a4b39',
                            greenLight: '#eef6f4',
                            orange: '#f26941',
                            cream: '#fdfbf6',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { background-color: #fdfbf6; }
        .sidebar-scroll::-webkit-scrollbar { width: 6px; }
        .sidebar-scroll::-webkit-scrollbar-track { background: transparent; }
        .sidebar-scroll::-webkit-scrollbar-thumb { background-color: #e5e7eb; border-radius: 20px; }
    </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col text-gray-800">

    <!-- Top Navigation -->
    <nav class="relative z-50 w-full py-5 px-6 md:px-12 flex items-center justify-between border-b border-gray-100 bg-white">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2">
            <img src="{{ asset('images/logo.png') }}" alt="PharmaAlert Logo" class="h-10">
            <span class="text-xl font-serif font-bold text-pharma-green">Pharma<span class="text-pharma-orange italic">Alert</span></span>
        </a>

        <!-- Links (Desktop) -->
        <div class="hidden md:flex items-center gap-8 text-sm font-medium text-gray-600">
            <a href="/recherche-medicaments" class="hover:text-pharma-green transition-colors">Rechercher</a>
            <a href="/pharmacies-garde" class="hover:text-pharma-green transition-colors">Pharmacies de garde</a>
            <a href="/estimation-prix" class="text-pharma-green font-semibold">Prix</a>
            <a href="#" class="hover:text-pharma-green transition-colors">Aide</a>
            <a href="#" class="hover:text-pharma-green transition-colors">Pour pharmacies</a>
        </div>

        <!-- CTA (Desktop) -->
        <div class="hidden md:flex items-center gap-6">
            <a href="#" class="bg-pharma-green text-white px-5 py-2.5 rounded-lg text-sm font-medium hover:bg-pharma-greenDark transition-colors shadow-sm">
                Installer l'app
            </a>
        </div>

        <!-- Mobile menu button -->
        <button onclick="toggleMobileMenu()" class="md:hidden text-gray-600 focus:outline-none p-2">
            <i class="fas fa-bars text-2xl"></i>
        </button>

        <!-- Mobile Menu (Hidden by default) -->
        <div id="mobileMenu" class="hidden absolute top-full left-0 w-full bg-white border-b border-gray-100 shadow-xl flex-col z-50">
            <a href="/recherche-medicaments" class="px-6 py-4 text-gray-600 hover:text-pharma-green border-b border-gray-50">Rechercher</a>
            <a href="/pharmacies-garde" class="px-6 py-4 text-gray-600 hover:text-pharma-green border-b border-gray-50">Pharmacies de garde</a>
            <a href="/estimation-prix" class="px-6 py-4 text-pharma-green font-semibold border-b border-gray-50">Prix</a>
            <a href="#" class="px-6 py-4 text-gray-600 hover:text-pharma-green border-b border-gray-50">Aide</a>
            <a href="#" class="px-6 py-4 text-gray-600 hover:text-pharma-green border-b border-gray-50">Pour pharmacies</a>
            <div class="px-6 py-4 flex flex-col gap-3 bg-gray-50">
                <a href="#" class="bg-pharma-green text-white px-5 py-3 rounded-xl text-center font-medium">Installer l'app</a>
            </div>
        </div>
    </nav>

    <script>
        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            if (menu.classList.contains('hidden')) {
                menu.classList.remove('hidden');
                menu.classList.add('flex');
            } else {
                menu.classList.add('hidden');
                menu.classList.remove('flex');
            }
        }
    </script>

    <!-- Main Content -->
    <main class="flex-1 max-w-4xl w-full mx-auto p-4 md:p-8">
        
        <div class="text-center mb-8 md:mb-12 mt-6">
            <h1 class="text-3xl md:text-4xl font-serif font-bold text-pharma-green mb-4">Estimez le coût de vos ordonnances</h1>
            <p class="text-gray-500 text-sm md:text-base max-w-2xl mx-auto">Ajoutez vos médicaments ci-dessous pour obtenir une idée du prix moyen pratiqué en pharmacie. Les prix sont donnés à titre indicatif.</p>
        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden flex flex-col md:flex-row">
            
            <!-- Left Side: Search Form -->
            <div class="p-6 md:p-8 flex-1 border-b md:border-b-0 md:border-r border-gray-100">
                <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                    <div class="w-8 h-8 rounded-full bg-pharma-greenLight text-pharma-green flex items-center justify-center mr-3">1</div>
                    Ajouter un médicament
                </h2>

                <div class="mb-6">
                    <div class="relative">
                        <div class="flex items-center border border-gray-200 rounded-xl overflow-hidden focus-within:border-pharma-green focus-within:ring-1 focus-within:ring-pharma-green">
                            <div class="pl-4 pr-3 text-gray-400"><i class="fas fa-search"></i></div>
                            <input type="text" id="medicamentInput" autocomplete="off" placeholder="Ex: Paracétamol 500mg" class="flex-1 py-3.5 outline-none text-sm font-medium text-gray-700">
                        </div>
                        <!-- Dropdown autocompletion -->
                        <ul id="autocompleteList" class="absolute z-50 w-full bg-white border border-gray-200 rounded-lg shadow-xl mt-1 hidden max-h-60 overflow-y-auto"></ul>
                    </div>
                </div>

                <!-- 
                <div class="relative flex items-center py-2 mb-6">
                    <div class="flex-grow border-t border-gray-200"></div>
                    <span class="flex-shrink-0 mx-4 text-gray-400 text-sm font-medium">OU</span>
                    <div class="flex-grow border-t border-gray-200"></div>
                </div>

                <div class="mb-6">
                    <button type="button" onclick="document.getElementById('ordonnanceInput').click()" class="w-full bg-white border-2 border-dashed border-pharma-green text-pharma-green hover:bg-pharma-greenLight font-semibold py-4 rounded-xl transition-colors flex flex-col items-center justify-center gap-2 group">
                        <i class="fas fa-camera text-2xl group-hover:scale-110 transition-transform"></i>
                        <span>Scanner une ordonnance</span>
                        <span class="text-xs font-normal text-gray-500">L'IA va extraire les médicaments automatiquement</span>
                    </button>
                    <input type="file" id="ordonnanceInput" accept="image/*" class="hidden" onchange="handleOrdonnanceUpload(event)">
                </div>
                -->

                <div class="p-4 bg-blue-50 rounded-xl flex gap-3 text-blue-700 text-sm">
                    <i class="fas fa-info-circle mt-0.5"></i>
                    <p>Recherchez un médicament dans la barre ci-dessus et cliquez dessus pour l'ajouter à votre devis estimatif.</p>
                </div>
            </div>

            <!-- Right Side: Quotation / Receipt -->
            <div class="p-6 md:p-8 w-full md:w-[380px] bg-gray-50/50 flex flex-col">
                <h2 class="text-lg font-bold text-gray-800 mb-6 flex items-center">
                    <div class="w-8 h-8 rounded-full bg-pharma-greenLight text-pharma-green flex items-center justify-center mr-3">2</div>
                    Votre Devis
                </h2>

                <div id="emptyCart" class="text-center py-10 flex-1 flex flex-col items-center justify-center text-gray-400">
                    <i class="fas fa-receipt text-4xl mb-4 opacity-50"></i>
                    <p class="text-sm">Votre liste est vide.</p>
                </div>

                <div id="cartContent" class="hidden flex-1 flex flex-col">
                    <ul id="medicamentList" class="flex-1 space-y-3 overflow-y-auto sidebar-scroll pr-2 mb-6 max-h-[300px]">
                        <!-- List items injected via JS -->
                    </ul>

                    <div class="mt-auto border-t border-gray-200 pt-4">
                        <div class="flex justify-between items-center mb-2">
                            <span class="text-gray-500 font-medium text-sm">Sous-total</span>
                            <span id="subTotal" class="font-semibold text-gray-800 text-sm">0 FCFA</span>
                        </div>
                        <div class="flex justify-between items-center mb-6">
                            <span class="text-gray-500 font-medium text-sm">Frais (Estimation)</span>
                            <span class="font-semibold text-gray-800 text-sm">0 FCFA</span>
                        </div>
                        
                        <div class="bg-pharma-green rounded-2xl p-5 text-white shadow-md flex justify-between items-center">
                            <div>
                                <p class="text-pharma-greenLight text-xs font-semibold uppercase tracking-wider mb-1">Total Estimatif</p>
                                <p id="totalPrice" class="text-2xl font-bold">0 <span class="text-lg font-medium opacity-80">FCFA</span></p>
                            </div>
                            <div class="w-10 h-10 rounded-full bg-white/20 flex items-center justify-center">
                                <i class="fas fa-wallet text-xl"></i>
                            </div>
                        </div>

                        <button onclick="window.location.href='/recherche-medicaments'" class="w-full mt-4 bg-white border border-gray-200 text-gray-700 font-semibold py-3 rounded-xl hover:bg-gray-50 transition-colors shadow-sm flex justify-center items-center">
                            <i class="fas fa-search-location mr-2 text-pharma-green"></i> Chercher ces médicaments
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </main>

    <script>
        let medicaments = [];
        
        function formatPrice(price) {
            return new Intl.NumberFormat('fr-FR').format(price || 0) + ' FCFA';
        }

        function addMedicament(nom, prix) {
            medicaments.push({ nom, prix: parseInt(prix) || 0 });
            document.getElementById('medicamentInput').value = '';
            renderList();
            
            // Save to local storage so they can be carried over to search page if needed
            localStorage.setItem('pharma_pending_medicaments', JSON.stringify(medicaments.map(m => m.nom)));
        }

        function removeMedicament(index) {
            medicaments.splice(index, 1);
            renderList();
            localStorage.setItem('pharma_pending_medicaments', JSON.stringify(medicaments.map(m => m.nom)));
        }

        function renderList() {
            const list = document.getElementById('medicamentList');
            const emptyCart = document.getElementById('emptyCart');
            const cartContent = document.getElementById('cartContent');
            
            list.innerHTML = '';
            let total = 0;

            if (medicaments.length === 0) {
                emptyCart.classList.remove('hidden');
                cartContent.classList.add('hidden');
                cartContent.classList.remove('flex');
            } else {
                emptyCart.classList.add('hidden');
                cartContent.classList.remove('hidden');
                cartContent.classList.add('flex');

                medicaments.forEach((m, i) => {
                    total += m.prix;
                    list.innerHTML += `
                        <li class="bg-white p-3 rounded-xl border border-gray-100 shadow-sm flex items-center justify-between group">
                            <div class="flex-1 pr-3 overflow-hidden">
                                <p class="font-bold text-gray-800 text-sm truncate" title="${m.nom}">${m.nom}</p>
                                <p class="text-pharma-green font-semibold text-xs mt-0.5">${formatPrice(m.prix)}</p>
                            </div>
                            <button onclick="removeMedicament(${i})" class="w-8 h-8 rounded-full bg-red-50 text-red-500 flex items-center justify-center hover:bg-red-500 hover:text-white transition-colors shrink-0">
                                <i class="fas fa-trash-alt text-xs"></i>
                            </button>
                        </li>`;
                });

                document.getElementById('subTotal').innerText = formatPrice(total);
                document.getElementById('totalPrice').innerHTML = new Intl.NumberFormat('fr-FR').format(total) + ' <span class="text-lg font-medium opacity-80">FCFA</span>';
            }
        }

        async function handleOrdonnanceUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            // Show loading state
            const uploadBtn = event.target.previousElementSibling;
            const originalHtml = uploadBtn.innerHTML;
            uploadBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-2xl"></i><span>Analyse en cours...</span><span class="text-xs font-normal text-gray-500">Cela peut prendre quelques secondes</span>';
            uploadBtn.disabled = true;
            uploadBtn.classList.add('opacity-70', 'cursor-not-allowed');

            const formData = new FormData();
            formData.append('image', file);

            try {
                const response = await fetch('/api/v1/public/prescription/extract', {
                    method: 'POST',
                    body: formData
                });
                
                const result = await response.json();
                
                if (response.ok) {
                    if (result.found && result.found.length > 0) {
                        result.found.forEach(med => {
                            addMedicament(med.libelle, med.prix);
                        });
                        
                        let msg = `${result.found.length} médicament(s) trouvé(s) et ajouté(s) avec succès !`;
                        if (result.not_found && result.not_found.length > 0) {
                            msg += `\n\nCertains médicaments n'ont pas été trouvés dans notre base : \n- ${result.not_found.join('\n- ')}`;
                        }
                        alert(msg);
                    } else {
                        alert("L'ordonnance a été analysée, mais aucun médicament n'a été trouvé dans notre base de données.");
                    }
                } else {
                    alert('Erreur lors de l\'analyse: ' + (result.error || 'Erreur inconnue'));
                }
            } catch (error) {
                console.error(error);
                alert('Une erreur est survenue lors de l\'envoi de l\'image.');
            } finally {
                // Restore button
                uploadBtn.innerHTML = originalHtml;
                uploadBtn.disabled = false;
                uploadBtn.classList.remove('opacity-70', 'cursor-not-allowed');
                event.target.value = ''; // Reset input
            }
        }

        // Autocompletion
        const inputField = document.getElementById('medicamentInput');
        const autocompleteList = document.getElementById('autocompleteList');
        let autocompleteTimeout = null;

        inputField.addEventListener('input', function() {
            const val = this.value.trim();
            if (val.length < 2) {
                autocompleteList.innerHTML = '';
                autocompleteList.classList.add('hidden');
                return;
            }

            if (autocompleteTimeout) clearTimeout(autocompleteTimeout);
            
            autocompleteTimeout = setTimeout(async () => {
                if (inputField.value.trim() !== val) return;

                try {
                    // Utiliser le nouvel endpoint qui retourne { nom, prix }
                    const res = await fetch(`/api/v1/public/recherche-medicament/autocomplete-prix?q=${encodeURIComponent(val)}`);
                    const data = await res.json();
                    
                    if (inputField.value.trim() !== val) return;

                    if (res.ok && data.data && data.data.length > 0) {
                        autocompleteList.innerHTML = '';
                        data.data.forEach(item => {
                            const li = document.createElement('li');
                            li.className = 'px-4 py-3 hover:bg-pharma-greenLight cursor-pointer border-b border-gray-50 last:border-0 flex justify-between items-center transition-colors';
                            li.innerHTML = `
                                <div class="flex items-center overflow-hidden pr-3">
                                    <i class="fas fa-pills text-gray-300 mr-3 shrink-0"></i>
                                    <span class="text-sm font-semibold text-gray-700 truncate">${item.nom}</span>
                                </div>
                                <span class="text-xs font-bold text-pharma-green shrink-0 bg-white px-2 py-1 rounded shadow-sm border border-gray-100">${formatPrice(item.prix)}</span>
                            `;
                            li.addEventListener('click', () => {
                                addMedicament(item.nom, item.prix);
                                autocompleteList.innerHTML = '';
                                autocompleteList.classList.add('hidden');
                            });
                            autocompleteList.appendChild(li);
                        });
                        autocompleteList.classList.remove('hidden');
                    } else {
                        autocompleteList.innerHTML = '<li class="px-4 py-3 text-sm text-gray-500 text-center">Aucun médicament trouvé</li>';
                        autocompleteList.classList.remove('hidden');
                    }
                } catch (e) {
                    console.error('Erreur autocompletion:', e);
                }
            }, 300); // 300ms debounce
        });

        // Cacher la liste si on clique ailleurs
        document.addEventListener('click', function(e) {
            if (e.target !== inputField && !autocompleteList.contains(e.target)) {
                autocompleteList.classList.add('hidden');
            }
        });

        // Initialize empty state
        renderList();
    </script>
</body>
</html>
